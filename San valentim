<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarjeta de San Valentín</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #ffe6e6;
            font-family: Arial, sans-serif;
        }
        .card {
            background: white;
            width: 300px;
            height: 400px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            padding: 20px;
            position: relative;
        }
        .heart {
            color: red;
            font-size: 50px;
            animation: heartbeat 1s infinite;
        }
        @keyframes heartbeat {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }
        .message {
            display: none;
            margin-top: 20px;
            font-size: 18px;
            color: #d6336c;
        }
        .button {
            background-color: #ff4d4d;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
        }
        .button:hover {
            background-color: #e60000;
        }
    </style>
</head>
<body>

    <div class="card">
        <h2>Feliz San Valentín ❤️</h2>
        <div class="heart">❤️</div>
        <button class="button" onclick="mostrarMensaje()">Haz clic aquí</button>
        <p class="message" id="mensaje">Eres la persona más especial para mí. ¡Te quiero mucho! 💖</p>
    </div>

    <script>
        function mostrarMensaje() {
            document.getElementById("mensaje").style.display = "block";
        }
    </script>

</body>
</html>
